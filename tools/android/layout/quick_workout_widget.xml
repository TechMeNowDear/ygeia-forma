<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Προπόνηση σήμερα» (13/11). Τα κείμενα εδώ φαίνονται μόνο στην προεπισκόπηση· τα αληθινά τα βάζει το
     QuickWidgets.kt. Χρώματα ημέρας/νύχτας από values και values-night. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qw_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="ΠΡΟΠΟΝΗΣΗ ΣΗΜΕΡΑ"
        android:textColor="@color/qw_workout"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/qw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Προπόνηση Α"
        android:textColor="@color/qw_text"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/qw_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="6 ασκήσεις · περίπου 55′"
        android:textColor="@color/qw_sub"
        android:textSize="13sp" />
</LinearLayout>
